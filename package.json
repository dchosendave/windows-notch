  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "release": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
